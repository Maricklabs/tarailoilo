# Copy to `.env` (never commit `.env`) and run:
#   flutter run --dart-define-from-file=.env
# ONLY public values belong here. Gemini / Contentful / Apify keys are
# Supabase secrets used by Edge Functions, never the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
